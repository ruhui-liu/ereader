<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed so that self-hosted, OpenAI-compatible translation servers on the local
     network (e.g. Ollama at http://192.168.x.x:11434) can be used. Everything else uses HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
